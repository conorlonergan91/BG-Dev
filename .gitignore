# Python
__pycache__/
*.pyc
.venv/
venv/
.env

# Node (Figma plugin / puppeteer helpers, if used)
node_modules/

# Scratch render output (regenerated from data — disposable).
# NOTE: games/<slug>/exports/ IS committed — it holds the curated, shareable deliverables
# (deck sheets, cover, rulebook PDF, track, tokens). Only build/ (scratch) is ignored.
games/**/build/
# Root-level scratch build dir (e.g. a tool run from the repo root) — disposable, never tracked.
/build/
# AI-art MOCKUPS: gitignored EXPLORATION scratch by default (build/ above covers build/mockups/). A game's
# CD-APPROVED playtest mock-ups MAY be committed under games/<slug>/art/mockups/ (clearly labelled MOCKUP,
# see that dir's README) so they persist across the ephemeral container and boards re-render warm — but
# they are NEVER copied into exports/ and NEVER treated as final art (human illustration + the Taiwanese
# consultant are still required before any real/print use).
tools/**/out/
*.tmp

# Blender
*.blend1
*.blend2

# OS
.DS_Store
Thumbs.db

# Keep the games directory itself
!games/.gitkeep
games/travel-agents/playtests/probe_v62_authoritative.txt
